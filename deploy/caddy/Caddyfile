(no_tls) {
}

(tls_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}

{$AIC_API_HOSTNAME::8080} {
	encode zstd gzip

	# Bỏ 2026-09-29: video đi thẳng từ S3, dịch vụ drive-proxy đã gỡ.
	# @drive path /video/*
	# reverse_proxy @drive drive-proxy:5000

	reverse_proxy api:8000

	import {$AIC_TLS_SNIPPET:no_tls}
}
