{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListIndexPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::aic2026-artifacts",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["indexes", "indexes/*"]
        }
      }
    },
    {
      "Sid": "ReadIndexObjectMetadata",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::aic2026-artifacts/indexes/*"
    }
  ]
}
