.env.*
!.env.example
*.local

# Google service account keys
service-account*.json
**/service-account*.json

# Deployment credentials: Drive service account, TLS keys, SSH keys.
# `.env.deploy` is already covered by the `.env.*` rule above.
secrets/
*.pem
!**/node_modules/**/*.pem

# ===== Python (backend) =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ===== Large data / model artifacts (provide out-of-band, too big for git) =====
# FAISS indexes, the keyframe database, id->path maps and the ~294k keyframe images.
backend/app/data/*
!backend/app/data/README.md
backend/app/static/images/

