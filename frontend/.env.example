# Copy this file to `.env` and fill in your own values.
# NOTE: Vite only exposes variables prefixed with VITE_ to the client bundle.
API_BASE_URL=http://localhost:8000
GOOGLE_API_KEY=your_google_api_key_here

# Where keyframe stills are served from. Defaults to ${VITE_API_BASE_URL}/static,
# which is what the Vite dev proxy forwards. Point it at the CDN to see real
# images against the deployed frame bucket:
#   VITE_IMAGE_BASE_URL=https://aic-frames.umaga.fun
VITE_IMAGE_BASE_URL=
