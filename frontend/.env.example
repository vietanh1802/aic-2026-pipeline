# Copy this file to `.env` and fill in your own values.
# NOTE: Vite only exposes variables prefixed with VITE_ to the client bundle.
API_BASE_URL=http://localhost:8000
GOOGLE_API_KEY=your_google_api_key_here

# Where keyframe stills are served from. Leave this unset to fall back to
# ${VITE_API_BASE_URL}/static, which is what the Vite dev proxy forwards.
# An empty assignment is NOT the same as unset — Vite loads it as "" and the
# ?? default in helpers/videoSource.ts will not fire, so every still 404s.
# Uncomment to point at the deployed frame bucket:
# VITE_IMAGE_BASE_URL=https://aic-frames.umaga.fun
