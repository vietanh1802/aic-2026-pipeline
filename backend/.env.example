# Copy thành `.env`. Được nạp bởi app/__init__.py.

# Model bật cho /ensemble-search. Bỏ trống = cả hai (beit3,clip).
# Đặt "beit3" khi chưa tải weights OpenCLIP ViT-bigG-14 (~10GB); clip.index cũng
# chỉ phủ 105,817/868,524 frame (K19, L25, một phần L26).
AIC_MODELS=beit3

# Bỏ trống = mặc định trong preprocess.py:
# AIC_INDEX_DIR=          backend/app/indexes/
# AIC_IMAGES_DIR=         backend/app/static/images/
# AIC_IMAGE_BASE_URL=     http://localhost:8000/static

# Chỉ agent.py dùng — hiện không cần (/text-search đã bị xoá khỏi main.py).
GITHUB_TOKEN=your_github_token_here
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=gpt-4.1

# Chỉ Retrieval Evaluation benchmark dùng, khi dịch truy vấn VI→EN qua Gemini.
# App khởi động bình thường khi để trống; chỉ một lần chạy benchmark là hỏng
# (từng câu một) cho tới khi có key.
# Ngoại lệ: chọn translation policy "Google Translate (contest parity)" thì
# không cần key — nó đi endpoint gtx miễn phí giống nút Translate ở tab Search.
# Cùng key này phục vụ nút Expand (POST /api/expansion).
GEMINI_API_KEY=

# Nút Expand: fallback model local khi Gemini không gọi được (mạng thi chặn,
# hết quota...).
#
# TRÊN EC2: BỎ TRỐNG. Card của instance không đủ VRAM cho qwen 27B cạnh
# CLIP bigG + BEiT3 (≈14GB đã chiếm, qwen cần ≈20GB) — nhét vào là OOM chết
# cả search stack. EC2 chạy Gemini-only; khi hết quota thì nút Expand báo lỗi
# rõ ràng thay vì kéo cả server theo.
#
# TRÊN MÁY THI (máy nhóm tự chạy backend): đặt tới Ollama local, kéo
# qwen về trước (ollama pull qwen3.8:27b). Đây là đường sống khi mạng thi
# chặn Google, và cũng là provider mạnh hơn trên đề khó (A/B 2026: qwen
# 25.6% vs gemini 10.0% hit@1).
# AIC_OLLAMA_URL=http://localhost:11434
# AIC_OLLAMA_MODEL=qwen3.8:27b
