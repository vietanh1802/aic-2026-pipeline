# Copy thành `.env`. Được nạp bởi app/__init__.py.

# Model bật cho /ensemble-search. Bỏ trống = cả hai (beit3,clip).
# Đặt "beit3" khi chưa tải weights OpenCLIP ViT-bigG-14 (~10GB); clip.index cũng
# chỉ phủ 105,817/868,524 frame (K19, L25, một phần L26).
AIC_MODELS=beit3

# Bỏ trống = mặc định trong preprocess.py:
# AIC_INDEX_DIR=          backend/app/indexes/
# AIC_IMAGES_DIR=         backend/app/static/images/
# AIC_IMAGE_BASE_URL=     http://localhost:8000/static

# Chỉ agent.py dùng — hiện không cần (/text-search đã bị xoá khỏi main.py).
GITHUB_TOKEN=your_github_token_here
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
GITHUB_MODELS_MODEL=gpt-4.1

# Gemini API key used only by the Evaluation translator.
GEMINI_API_KEY=
